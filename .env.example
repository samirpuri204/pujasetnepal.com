# ---------------------------------------------------------------------------
# Puja Set Nepal — server configuration
#
# Copy to .env.local for local development, and set the same keys in the Vercel
# project settings for production. Nothing here is prefixed with NEXT_PUBLIC_,
# on purpose: these are read by the server routes only, so the upstream endpoint
# never ends up in the browser bundle.
#
# Legacy note: every key below also responds to its older `JAYNEPAL_*` name, so
# existing deployments keep working. A non-empty `PUJASET_*` value wins;
# otherwise the `JAYNEPAL_*` value is used. See docs#configuration.
# ---------------------------------------------------------------------------

# Base URL of the inference server. It must speak the OpenAI chat-completions
# API, exposing /v1/models and /v1/chat/completions — vLLM, llama.cpp, Ollama,
# the project notebook, or any hosted equivalent.
#
# All of these are accepted and normalised:
#   https://your-endpoint.example.com
#   https://your-endpoint.example.com/v1
#   https://your-endpoint.example.com/v1/chat/completions
#
# Leave it empty to run the UI with no model attached — the header will show
# "Not configured" instead of failing on the first message.
PUJASET_API_URL=

# The model id sent in the request body. Only matters if the server serves more
# than one; most single-model servers ignore it.
PUJASET_MODEL=jaynepal-1.1

# Generation settings, passed through to the server.
#
# PUJASET_MAX_TOKENS must stay under (maxDuration x tokens-per-second) for the
# backend in use, or the tail of every long answer gets truncated. With the
# 300s ceiling in src/app/api/chat/route.ts, 1024 is ~4 tokens/second of
# headroom — comfortable for a GPU, tight for CPU-only inference.
PUJASET_TEMPERATURE=0.7
PUJASET_MAX_TOKENS=1024

# Optional. Unset uses the built-in persona (see src/lib/system-prompt.ts).
# Set to an empty string to send no system turn at all — useful if the backend
# already prepends its own and you do not want two.
# PUJASET_SYSTEM_PROMPT=
